{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a registered user of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth ID" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's full name" },
        "photoURL": { "type": "string", "description": "User's profile picture URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of account creation" },
        "lastLogin": { "type": "string", "format": "date-time", "description": "Timestamp of last login" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by their Firebase internal UID."
    }
  }
}
